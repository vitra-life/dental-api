/// A person who can sign in. Independent of any clinic; access comes from
/// `clinic_memberships`.
model User {
  id                    String    @id @default(uuid(7)) @db.Char(36)
  full_name             String    @db.VarChar(255)
  /// The login identifier.
  mobile                String    @unique @db.VarChar(11)
  /// argon2id hash; never the password itself.
  password_hash         String    @db.VarChar(255)
  is_active             Boolean   @default(true)
  /// Set for temporary passwords; the user must choose a new one first.
  must_change_password  Boolean   @default(false)
  failed_login_attempts Int       @default(0) @db.UnsignedSmallInt
  /// Set after too many failed logins.
  locked_until          DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@map("users")
}

/// One signed-in device. Holds the hash of its current refresh token and the
/// clinic the user is working in.
model AuthSession {
  id                  String    @id @default(uuid(7)) @db.Char(36)
  user_id             String    @db.Char(36)
  active_clinic_id    String?   @db.Char(36)
  /// SHA-256 of the current refresh token.
  refresh_token_hash  String    @unique @db.Char(64)
  /// SHA-256 of the refresh token it replaced, to detect reuse.
  previous_token_hash String?   @db.Char(64)
  expires_at          DateTime
  revoked_at          DateTime?
  last_used_at        DateTime  @default(now())
  user_agent          String?   @db.VarChar(255)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@index([user_id])
  @@index([previous_token_hash])
  @@map("auth_sessions")
}

/// A user's membership in one clinic. Roles and staff types hang off this.
model ClinicMembership {
  id         String   @id @default(uuid(7)) @db.Char(36)
  clinic_id  String   @db.Char(36)
  user_id    String   @db.Char(36)
  is_active  Boolean  @default(true)
  joined_at  DateTime @default(now())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([clinic_id, user_id])
  @@index([user_id])
  @@map("clinic_memberships")
}
