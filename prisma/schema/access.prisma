/// What a workspace is:
enum WorkspaceKind {
  /// A doctor's own practice: the doctor is the member themself.
  doctor
  /// A secretary, assistant, ... of one doctor.
  staff
  /// Clinic-wide, not tied to a doctor (the admin, a reception desk).
  clinic
}

/// One position of a person in a clinic, e.g. "assistant of Dr A". The user
/// picks a workspace after login; it decides what they may do (its
/// permissions) and whose data they see (its doctor, or the whole clinic).
model Workspace {
  id                   String        @id @default(uuid(7)) @db.Char(36)
  clinic_id            String        @db.Char(36)
  /// The person holding the position.
  membership_id        String        @db.Char(36)
  kind                 WorkspaceKind
  /// The doctor whose data the workspace sees; null for clinic-wide ones.
  /// For `doctor` workspaces it equals `membership_id`.
  doctor_membership_id String?       @db.Char(36)
  /// For `staff` workspaces: secretary_of, assistant_of, ...
  relationship_type_id String?       @db.Char(36)
  /// Clinic admin: holds every permission, including ones added later.
  is_admin             Boolean       @default(false)
  is_active            Boolean       @default(true)
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt

  @@index([clinic_id, membership_id])
  @@index([clinic_id, doctor_membership_id])
  @@map("workspaces")
}

/// A permission granted to a workspace. The workspace itself is the scope.
model WorkspacePermission {
  id            String   @id @default(uuid(7)) @db.Char(36)
  clinic_id     String   @db.Char(36)
  workspace_id  String   @db.Char(36)
  permission_id String   @db.Char(36)
  created_at    DateTime @default(now())

  @@unique([workspace_id, permission_id])
  @@index([permission_id])
  @@map("workspace_permissions")
}

/// One action of the permission catalogue, e.g. `appointment.create`. Kept in
/// sync with `permission-catalog.ts` by the seed.
model Permission {
  id            String   @id @default(uuid(7)) @db.Char(36)
  /// `resource.action`, e.g. `appointment.cancel`.
  code          String   @unique @db.VarChar(128)
  /// The group it is shown under, e.g. `appointments`.
  group_code    String?  @db.VarChar(64)
  /// Persian label for the permissions screen.
  label         String   @db.VarChar(255)
  description   String?  @db.Text
  sort_order    Int      @default(0)
  /// False once an item is removed from the catalogue; grants are kept but ignored.
  is_assignable Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([group_code])
  @@map("permissions")
}

/// A clinic's reusable set of permissions, e.g. "standard secretary".
/// Applying it copies its items into a workspace; later edits to the template
/// don't change workspaces it was applied to.
model PermissionTemplate {
  id         String   @id @default(uuid(7)) @db.Char(36)
  clinic_id  String   @db.Char(36)
  code       String   @db.VarChar(64)
  name       String   @db.VarChar(255)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([clinic_id, code])
  @@map("permission_templates")
}

model PermissionTemplateItem {
  id            String   @id @default(uuid(7)) @db.Char(36)
  template_id   String   @db.Char(36)
  permission_id String   @db.Char(36)
  created_at    DateTime @default(now())

  @@unique([template_id, permission_id])
  @@index([permission_id])
  @@map("permission_template_items")
}
