// Field names are snake_case on purpose: they are returned as-is by the API
// and match the row types in the frontend (Dental-App/src/lib/types.ts).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

/// A tenant. Every other table will carry a `clinic_id` pointing here.
model Clinic {
  id         String   @id @default(uuid(7)) @db.Char(36)
  name       String   @db.VarChar(255)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  clients      Client[]
  services     Service[]
  appointments Appointment[]

  @@map("clinics")
}

enum Gender {
  male
  female
}

enum ServiceCategory {
  general
  endodontics
  surgery
  prosthodontics
  cosmetic
  orthodontics
}

enum AppointmentStatus {
  pending
  confirmed
  completed
  cancelled
  no_show
}

model Client {
  id                String    @id @default(uuid(7)) @db.Char(36)
  clinic_id         String    @db.Char(36)
  first_name        String    @db.VarChar(100)
  last_name         String    @db.VarChar(100)
  phone             String    @db.VarChar(11)
  national_id       String?   @db.Char(10)
  birth_date        DateTime? @db.Date
  gender            Gender
  email             String?   @db.VarChar(255)
  /// One of A+, A-, B+, B-, AB+, AB-, O+, O-. Validated by the API.
  blood_type        String?   @db.VarChar(3)
  address           String?   @db.Text
  /// Free text, entries separated by a comma or "،".
  allergies         String?   @db.Text
  /// Free text, entries separated by a comma or "،".
  medical_history   String?   @db.Text
  emergency_contact String?   @db.VarChar(255)
  emergency_phone   String?   @db.VarChar(11)
  insurance_company String?   @db.VarChar(255)
  insurance_number  String?   @db.VarChar(50)
  notes             String?   @db.Text
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  clinic       Clinic        @relation(fields: [clinic_id], references: [id])
  appointments Appointment[]

  @@unique([clinic_id, phone])
  @@map("clients")
}

model Service {
  id               String          @id @default(uuid(7)) @db.Char(36)
  clinic_id        String          @db.Char(36)
  name             String          @db.VarChar(255)
  category         ServiceCategory @default(general)
  /// In Rial.
  default_price    Int             @default(0) @db.UnsignedInt
  duration_minutes Int             @default(30) @db.UnsignedSmallInt
  description      String?         @db.Text
  /// Inactive services are hidden when booking but kept for past appointments.
  active           Boolean         @default(true)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  clinic       Clinic        @relation(fields: [clinic_id], references: [id])
  appointments Appointment[]

  @@unique([clinic_id, name])
  @@map("services")
}

model Appointment {
  id          String            @id @default(uuid(7)) @db.Char(36)
  clinic_id   String            @db.Char(36)
  client_id   String            @db.Char(36)
  service_id  String            @db.Char(36)
  /// Stored in UTC.
  start_time  DateTime
  /// Stored in UTC.
  end_time    DateTime
  status      AppointmentStatus @default(pending)
  /// In Rial. Prefilled from the service's default price.
  price       Int               @default(0) @db.UnsignedInt
  description String?           @db.Text
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt

  clinic  Clinic  @relation(fields: [clinic_id], references: [id])
  client  Client  @relation(fields: [client_id], references: [id], onDelete: Restrict)
  service Service @relation(fields: [service_id], references: [id], onDelete: Restrict)

  @@index([clinic_id, start_time])
  @@index([client_id])
  @@index([service_id])
  @@map("appointments")
}
