# Copy to .env and adjust.

# ── App ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# debug | info | warn | error
LOG_LEVEL=debug

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# Serve the OpenAPI docs at /api/docs. Leave off in production.
SWAGGER_ENABLED=true

# ── Database (docker-compose.yml reads the MYSQL_* values; the database
#    and user are both named `dental`) ─────────────────────────────────
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
MYSQL_PORT=3306

# Must agree with the MYSQL_* values above. allowPublicKeyRetrieval is needed
# for MySQL's default password plugin over a non-TLS local connection.
DATABASE_URL=mysql://dental:change-me@localhost:3306/dental?allowPublicKeyRetrieval=true
